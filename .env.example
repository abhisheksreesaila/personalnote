# Leave PERSONAL_NOTE_MODEL empty for keyless local retrieval.
PERSONAL_NOTE_MODEL=

# Intelligence tier: local-only | local-first | cloud-ok
# local-first = on-device models when configured; cloud skipped unless tier is cloud-ok
PERSONAL_NOTE_INTELLIGENCE_TIER=local-first

# Ollama's OpenAI-compatible endpoint. LM Studio commonly uses
# http://127.0.0.1:1234/v1 instead.
PERSONAL_NOTE_MODEL_URL=http://127.0.0.1:11434/v1
PERSONAL_NOTE_MODEL_KEY=local

# Azure OpenAI / Microsoft Foundry alternative. A deployment name activates
# the Azure provider even when PERSONAL_NOTE_MODEL is empty. The endpoint may
# be an Azure OpenAI endpoint or a Foundry project endpoint.
PERSONAL_NOTE_DEPLOYMENT_NAME=
PERSONAL_NOTE_AZURE_API_VERSION=v1
PERSONAL_NOTE_AZURE_DEPLOYMENT_URLS=0

# Reserved for the fh-saas Google OAuth integration. Authentication remains
# bypassed during local development until tenant scoping is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=

# Optional service configuration.
HOST=127.0.0.1
PORT=3137
# Set this to /app/data/personal-note.db when deploying with a Railway volume.
PERSONAL_NOTE_DB=
INTELLIGENCE_PORT=4112
INTELLIGENCE_URL=http://127.0.0.1:4112
INTELLIGENCE_ENRICH_TIMEOUT=4.0
LOG_LEVEL=INFO
FH_SAAS_LOG_LEVEL=WARNING

# Optional Vite build-time realtime ASR endpoint. Leave empty for the local
# ws://127.0.0.1:8080/v1/realtime default. Hosted deployments must use wss://.
VITE_LOCAL_ASR_ENDPOINT=

# Optional Agent Workspace Protocol capability overrides. When both are empty,
# the API creates a random local token at data/workspace.token.
PERSONAL_NOTE_AGENT_TOKEN=
PERSONAL_NOTE_AGENT_TOKEN_FILE=